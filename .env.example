DB_DATABASE=dockistry_platform
DB_USER=dockistry
DB_PASSWORD=dockistry

DB_URL="jdbc:postgresql://localhost:5432/${DB_DATABASE}"

POSTGRES_DB="${DB_DATABASE}"
POSTGRES_USER="${DB_USER}"
POSTGRES_PASSWORD="${DB_PASSWORD}"

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

DOCKER_IMAGE_PULL_TIMEOUT=300000

# Base64-encoded 256-bit key for Secret values (openssl rand -base64 32).
# Unset means the development key, which the prod profile rejects.
# SECRETS_ENCRYPTION_KEY=
